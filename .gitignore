```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
.next/
out/

# Environment variables
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Temporary files
*.tmp

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Coverage reports
coverage/
htmlcov/

# OS generated files
.DS_Store
Thumbs.db

# Package managers
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
.nyc_output/
coverage/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Debug log
debug.log

# Local configuration
.env.local
.env.development.local
.env.test.local
.env.production.local
```